{
  "name": "project-cai-market",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:credit": "node --wasm-num-compilation-tasks=1 --liftoff-only ./node_modules/@playwright/test/cli.js test -c playwright.credit.config.ts",
    "check:credit": "tsc -p tsconfig.credit.json",
    "check:api": "tsc -p worker/api/tsconfig.json && tsc -p tsconfig.api.json",
    "check:deployment": "node scripts/check-deployment.mjs",
    "check:frontend-config": "node --experimental-strip-types scripts/check-frontend-config.mts",
    "test:api": "playwright test -c playwright.api.config.ts",
    "dev:api": "npx wrangler@4 dev --config worker/api/wrangler.local.jsonc --local"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
